{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "decorator",
    "pages",
    "actionsComponents",
    "fixtures",
    "api",
    "constants",
    "reporting",
    "user",
    "tests",
    "playwright.config.ts"
  ]
}
